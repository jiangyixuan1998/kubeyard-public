# 复制为 .env 后填写；.env 含密码，务必加入 .gitignore，不入仓库

# MySQL root 密码（仅 mysql 容器初始化用）
MYSQL_ROOT_PASSWORD=

# kubeyard 业务账号密码（compose 会同时在 MySQL 与平台侧使用）
MYSQL_DB_PASSWORD=

# 下面两个密钥默认留空即可：首次启动自动生成随机密钥并存入数据库 settings 表，
# 随数据库备份/迁移即可（密钥丢失则已纳管集群需重新导入）。
# 多实例共用同一数据库、或需密钥与数据分离时才需显式指定（openssl rand -base64 32）：
# KUBEYARD_JWT_KEY=
# KUBEYARD_ENCRYPTION_KEY=
